# Local Postgres. Against a hosted database such as Supabase, use the session mode pooler on
# port 5432 rather than the transaction pooler on 6543, which cannot run migrations, and append
# ?schema=erp_portal so the application owns its own schema instead of a shared public one.
DATABASE_URL=postgresql://erp_admin:change_me@localhost:5432/erp_portal

# Optional. When set, reads go to this replica and writes stay on DATABASE_URL.
# Reads become eventually consistent, so leave it empty unless the primary is the bottleneck.
DATABASE_REPLICA_URL=
# Generate a fresh value per environment and never reuse this file's placeholder:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Optional. Shares the login rate limit across API instances.
# Leave empty to count attempts per process instead.
REDIS_URL=redis://localhost:6379

# Seconds to cache the dashboard summary per role. Needs REDIS_URL.
# 0 disables it, which is the default and what the free tier deployment runs.
DASHBOARD_CACHE_SECONDS=0
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
AWS_REGION=ap-south-1
# Leave empty to run without product image upload.
S3_IMAGE_BUCKET=
