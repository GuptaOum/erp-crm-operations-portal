{
  "name": "erp-portal-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1123.0",
    "@aws-sdk/s3-request-presigner": "3.1123.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.0",
    "multer": "2.3.0",
    "pdfkit": "0.20.2",
    "prisma": "6.19.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.2.0",
    "@types/node": "26.4.0",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
